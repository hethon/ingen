{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "app_name": {
      "type": "string",
      "minLength": 1
    },
    "base_urls": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "hosting": {
      "type": "object",
      "properties": {
        "github": {
          "type": "object",
          "properties": {
            "artifact_download_path": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "artifact_download_path"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "github"
      ],
      "additionalProperties": false
    },
    "install_success_msg": {
      "type": "string",
      "minLength": 1
    },
    "install_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "bin_aliases": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "tag": {
      "type": "string",
      "minLength": 1
    },
    "windows_archive": {
      "type": "string",
      "enum": [
        ".tar.gz",
        ".tar.xz",
        ".tar.zst",
        ".zip"
      ]
    },
    "unix_archive": {
      "type": "string",
      "enum": [
        ".tar.gz",
        ".tar.xz",
        ".tar.zst",
        ".zip"
      ]
    },
    "executables": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cdylibs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cstaticlibs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "checksum_style": {
      "type": "string",
      "enum": [
        "sha256",
        "sha512",
        "sha3-256",
        "sha3-512",
        "blake2s",
        "blake2b"
      ]
    },
    "min_glibc_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "platform_support": {
      "type": "object",
      "properties": {
        "archives": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "target_triple": {
                "type": "string",
                "pattern": "^[a-z0-9_]+(-[a-z0-9_.]+){2,4}$"
              },
              "checksum": {
                "type": "string",
                "minLength": 1
              },
              "executables": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "cdylibs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "cstaticlibs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "zip_style": {
                "type": "string",
                "enum": [
                  ".tar.gz",
                  ".tar.xz",
                  ".tar.zst",
                  ".zip"
                ]
              },
              "checksum_style": {
                "type": "string",
                "enum": [
                  "sha256",
                  "sha512",
                  "sha3-256",
                  "sha3-512",
                  "blake2s",
                  "blake2b"
                ]
              },
              "min_glibc_version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+$"
              }
            },
            "required": [
              "id",
              "target_triple"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "archives"
      ],
      "additionalProperties": false
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "app_name",
    "base_urls",
    "hosting",
    "install_success_msg",
    "install_paths",
    "bin_aliases",
    "owner",
    "repo",
    "version",
    "tag",
    "windows_archive",
    "unix_archive",
    "executables",
    "cdylibs",
    "cstaticlibs",
    "checksum_style",
    "min_glibc_version",
    "platform_support"
  ],
  "additionalProperties": false
}